# Mẫu biến môi trường cho giao diện. Chép thành .env.local rồi điền giá trị.
# .env.local KHÔNG đưa vào repo (.gitignore đã chặn).
#
# Mọi biến VITE_* được nhúng vào mã chạy trên trình duyệt, ai cũng đọc được.
# TUYỆT ĐỐI không đặt khoá bí mật (service_role, sb_secret_..., mật khẩu DB) vào biến VITE_*.
#
# Local: chạy `npm run db:start` (cần Docker), rồi `npx supabase status`
# để lấy "API URL" và "Publishable key" (hoặc "anon key").

# Địa chỉ API Supabase. Local thường là http://127.0.0.1:54321
VITE_SUPABASE_URL=

# Khoá công khai (publishable / anon). Không phải secret / service_role.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Tên môi trường: local | preview | staging | production
VITE_APP_ENV=local

# Site key Cloudflare Turnstile (công khai). Để trống ở local: dùng mã thử của Cloudflare.
VITE_TURNSTILE_SITE_KEY=
