{
  "name": "hmt-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check:hardcode": "node scripts/check-hardcoded.mjs",
    "check:all": "bash scripts/check-all.sh",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:seed-users": "node scripts/seed-users.ts",
    "db:seed-lon": "docker exec -i \"supabase_db_$(sed -n 's/^project_id = \"\\(.*\\)\"/\\1/p' supabase/config.toml)\" psql -U postgres -q < supabase/seed-lon.sql",
    "size": "node scripts/bundle-size.ts",
    "db:seed-lon-lop-buoi": "docker exec -i \"supabase_db_$(sed -n 's/^project_id = \"\\(.*\\)\"/\\1/p' supabase/config.toml)\" psql -U postgres -q < supabase/seed-lon-lop-buoi.sql",
    "db:seed-lon-phieu-thu": "docker exec -i \"supabase_db_$(sed -n 's/^project_id = \"\\(.*\\)\"/\\1/p' supabase/config.toml)\" psql -U postgres -q < supabase/seed-lon-phieu-thu.sql",
    "chup-anh": "bash scripts/chup-anh.sh"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@supabase/auth-js": "2.119.0",
    "@supabase/postgrest-js": "2.119.0",
    "@supabase/supabase-js": "2.119.0",
    "@tanstack/react-query": "5.107.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.72.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "otplib": "13.6.0",
    "pg": "8.23.1",
    "prettier": "3.10.1",
    "supabase": "2.122.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "wrangler": "4.161.0"
  }
}
